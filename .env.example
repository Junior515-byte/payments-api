# Base de datos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payments

# HTTP
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Pasarela (simulada, inspirada en Bancard vPOS)
GATEWAY_WEBHOOK_SECRET=change-me-gateway-secret
GATEWAY_CHECKOUT_BASE_URL=https://checkout.gateway.test/pay
# Probabilidad (0..1) de que la pasarela simulada falle al crear el checkout
GATEWAY_FAILURE_RATE=0
WEBHOOK_TOLERANCE_SECONDS=300

# Notificaciones al comercio (outbox)
MERCHANT_WEBHOOK_URL=http://localhost:3000/simulator/merchant/webhooks
MERCHANT_WEBHOOK_SECRET=change-me-merchant-secret
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8

# Reglas de negocio
PAYMENT_TTL_MINUTES=15
EXPIRATION_INTERVAL_MS=30000
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=30

# Habilita los endpoints /simulator (nunca en producción)
ENABLE_SIMULATOR=true
